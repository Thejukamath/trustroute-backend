# TrustRoute — real service API keys (all optional).
# Copy to .env and fill in the keys you have. Without keys, services fall back
# to the NEXT provider in the failover chain, then the simulator.
# See README.md → "Real service APIs".

# ── Weather ──
# Primary:  OpenWeather    https://openweathermap.org/api  (free tier OK)
OPENWEATHER_API_KEY=
# Backup:   WeatherAPI.com https://www.weatherapi.com/docs/ (free tier OK)
WEATHERAPI_KEY=

# ── News ──
# Primary:  GNews          https://gnews.io/              (free /day OK)
GNEWS_API_KEY=
# Backup:   NewsAPI.org    https://newsapi.org/          (free dev OK)
# Accepted names: NEWSAPI_KEY or NEWS_API_KEY
NEWSAPI_KEY=

# ── LLM (research + writing) ──
# Primary:  Google Gemini  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Backup:   OpenAI         https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Backup:   Anthropic      https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Demo ──
# Set to 1 to force the PRIMARY provider to fail once each run, so the
# failover path is always visible in a live demo.
DEMO_FAILOVER=0

# ══ REAL x402 payments — Algorand TestNet, USDC (ASA 10458941) ════════════════
# This is the x402 protocol (v2, "exact" scheme). There is NO simulated/mock
# payment path: paid endpoints return 503 until the values below are set.
#
# AVM_ADDRESS            The Algorand address this resource server receives
#   (REQUIRED)           USDC payments at. Generate one with:
#                        npm run setup-wallet   (prints AVM_ADDRESS + a payer
#                        wallet for the client side)
#   - Fund the address with testnet ALGO  : https://lora.algokit.io/testnet/fund
#   - Opt in to USDC ASA 10458941         : send a 0-amount USDC transfer to
#                                           itself (or use any Algorand wallet
#                                           UI in TestNet mode, e.g. Pera)
#   - Fund USDC testnet                   : https://faucet.circle.com/
#
AVM_ADDRESS=

# Optional overrides (defaults are the official Algorand TestNet — note the
# network id uses the FULL base64 genesis hash, as the facilitator registry does):
# AVM_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# AVM_GENESIS_HASH=SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# x402 facilitator that verifies + settles payments.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Client wallet (for the frontend, NOT the server):
#   AVM_MNEMONIC  = 25-word payer mnemonic — goes in client/.env as VITE_AVM_MNEMONIC
#   AVM_PRIVATE_KEY = base64 64-byte key (seed+pubkey) — alternative to mnemonic
# Run `npm run setup-wallet` to generate both for a fresh payer account.